-- ─────────────────────────────────────────────
-- STEP 3: DATA EXTRACTION QUERIES
-- ─────────────────────────────────────────────

-- Q1: View all data
SELECT * FROM beauty_products
ORDER BY year, product_name;

-- Q2: View only 2025 data
SELECT * FROM beauty_products
WHERE year = 2025;

-- Q3: View only 2026 data
SELECT * FROM beauty_products
WHERE year = 2026;


-- ─────────────────────────────────────────────
-- STEP 4: AGGREGATION QUERIES
-- ─────────────────────────────────────────────

-- Q4: Total Sales, Revenue, Profit, Loss by Year
SELECT
    year,
    SUM(buyers)      AS total_buyers,
    SUM(items_sold)  AS total_items_sold,
    SUM(returns)     AS total_returns,
    SUM(total_sales) AS total_sales,
    SUM(net_revenue) AS total_net_revenue,
    SUM(loss)        AS total_loss,
    SUM(net_profit)  AS total_net_profit
FROM beauty_products
GROUP BY year
ORDER BY year;

-- Q5: Total Sales per Product (Both Years)
SELECT
    product_name,
    SUM(total_sales)  AS total_sales,
    SUM(net_revenue)  AS total_revenue,
    SUM(net_profit)   AS total_profit,
    SUM(loss)         AS total_loss
FROM beauty_products
GROUP BY product_name
ORDER BY total_sales DESC;

-- Q6: Average Unit Price per Product
SELECT
    product_name,
    AVG(unit_price) AS avg_unit_price
FROM beauty_products
GROUP BY product_name
ORDER BY avg_unit_price DESC;


-- ─────────────────────────────────────────────
-- STEP 5: ANALYSIS QUERIES
-- ─────────────────────────────────────────────

-- Q7: Year-over-Year Growth Analysis
SELECT
    a.product_name,
    a.total_sales  AS sales_2025,
    b.total_sales  AS sales_2026,
    (b.total_sales - a.total_sales)                              AS sales_growth,
    ROUND((b.total_sales - a.total_sales) / a.total_sales * 100, 2) AS growth_pct
FROM
    (SELECT product_name, SUM(total_sales) AS total_sales FROM beauty_products WHERE year = 2025 GROUP BY product_name) a
JOIN
    (SELECT product_name, SUM(total_sales) AS total_sales FROM beauty_products WHERE year = 2026 GROUP BY product_name) b
ON a.product_name = b.product_name
ORDER BY growth_pct DESC;

-- Q8: Top 3 Best Performing Products by Profit (2026)
SELECT
    product_name,
    net_profit,
    total_sales,
    net_revenue
FROM beauty_products
WHERE year = 2026
ORDER BY net_profit DESC
LIMIT 3;

-- Q9: Products with Losses (any year)
SELECT
    product_name,
    year,
    loss,
    returns,
    net_profit
FROM beauty_products
WHERE loss > 0
ORDER BY loss DESC;

-- Q10: Products with High Return Rate
SELECT
    product_name,
    year,
    items_sold,
    returns,
    ROUND(returns / items_sold * 100, 2) AS return_rate_pct
FROM beauty_products
WHERE returns > 0
ORDER BY return_rate_pct DESC;

-- Q11: Overall KPI Summary (Both Years Combined)
SELECT
    SUM(total_sales)                          AS grand_total_sales,
    SUM(net_revenue)                          AS grand_total_revenue,
    SUM(net_profit)                           AS grand_total_profit,
    SUM(loss)                                 AS grand_total_loss,
    ROUND(AVG(unit_price), 2)                 AS avg_unit_price,
    SUM(items_sold)                           AS total_items_sold,
    SUM(returns)                              AS total_returns,
    ROUND(SUM(returns)/SUM(items_sold)*100,2) AS overall_return_rate_pct
FROM beauty_products;

-- Q12: Most Buyers by Product
SELECT
    product_name,
    SUM(buyers) AS total_buyers
FROM beauty_products
GROUP BY product_name
ORDER BY total_buyers DESC;
